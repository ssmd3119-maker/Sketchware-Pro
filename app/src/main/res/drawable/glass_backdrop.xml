<?xml version="1.0" encoding="utf-8"?>
<!-- Window background for Liquid Glass: soft colour fields that translucent surfaces pick up. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurface" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.1"
                android:centerY="0.05"
                android:endColor="@android:color/transparent"
                android:gradientRadius="75%p"
                android:startColor="@color/glass_backdrop_primary"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.95"
                android:centerY="0.8"
                android:endColor="@android:color/transparent"
                android:gradientRadius="80%p"
                android:startColor="@color/glass_backdrop_tertiary"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
