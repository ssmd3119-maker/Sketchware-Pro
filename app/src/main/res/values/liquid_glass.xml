<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Opacity of the translucent surface tokens. -->
    <item name="glass_alpha_surface_lowest" format="float" type="dimen">0.50</item>
    <item name="glass_alpha_surface_low" format="float" type="dimen">0.58</item>
    <item name="glass_alpha_surface" format="float" type="dimen">0.66</item>
    <item name="glass_alpha_surface_high" format="float" type="dimen">0.74</item>
    <item name="glass_alpha_surface_highest" format="float" type="dimen">0.82</item>
    <item name="glass_alpha_backdrop_blob" format="float" type="dimen">0.85</item>
    <!-- Dialogs and bottom sheets sit over arbitrary content. Without a real blur behind them
         (before Android 12) they stay nearly opaque so text remains readable. -->
    <item name="glass_alpha_dialog" format="float" type="dimen">0.95</item>

    <dimen name="glass_corner_radius">22dp</dimen>
    <dimen name="glass_blur_radius">24dp</dimen>
    <dimen name="glass_blur_behind_radius">28dp</dimen>

    <!--
      Applied on top of Theme.SketchwarePro by BaseAppCompatActivity when Liquid Glass is enabled
      in Settings > Appearance. Editors opt out, see BaseAppCompatActivity#supportsLiquidGlass().
    -->
    <style name="ThemeOverlay.SketchwarePro.LiquidGlass" parent="">
        <item name="liquidGlassEnabled">true</item>
        <item name="android:windowBackground">@drawable/glass_backdrop</item>

        <item name="colorSurfaceContainerLowest">@color/glass_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/glass_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/glass_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/glass_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/glass_surface_container_highest</item>

        <item name="materialCardViewFilledStyle">@style/Widget.SketchwarePro.CardView.Glass</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.SketchwarePro.AlertDialog.Glass</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.SketchwarePro.AlertDialog.Glass</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.SketchwarePro.BottomSheetDialog.Glass</item>
    </style>

    <style name="Widget.SketchwarePro.CardView.Glass">
        <item name="cardCornerRadius">@dimen/glass_corner_radius</item>
        <item name="cardBackgroundColor">@color/glass_surface_container</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/glass_ripple</item>
        <item name="android:stateListAnimator">@animator/glass_press</item>
    </style>

    <style name="MaterialAlertDialog.SketchwarePro.Glass">
        <item name="backgroundTint">@color/glass_dialog_surface</item>
    </style>

    <style name="Base.ThemeOverlay.SketchwarePro.AlertDialog.Glass" parent="ThemeOverlay.SketchwarePro.AlertDialog">
        <item name="android:colorBackground">@color/glass_dialog_surface</item>
        <item name="alertDialogStyle">@style/MaterialAlertDialog.SketchwarePro.Glass</item>
        <item name="android:backgroundDimAmount">0.32</item>
    </style>

    <style name="ThemeOverlay.SketchwarePro.AlertDialog.Glass" parent="Base.ThemeOverlay.SketchwarePro.AlertDialog.Glass" />

    <style name="Widget.SketchwarePro.BottomSheet.Modal.Glass">
        <item name="backgroundTint">@color/glass_dialog_surface</item>
    </style>

    <style name="Base.ThemeOverlay.SketchwarePro.BottomSheetDialog.Glass" parent="ThemeOverlay.SketchwarePro.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.SketchwarePro.BottomSheet.Modal.Glass</item>
        <item name="android:backgroundDimAmount">0.32</item>
    </style>

    <style name="ThemeOverlay.SketchwarePro.BottomSheetDialog.Glass" parent="Base.ThemeOverlay.SketchwarePro.BottomSheetDialog.Glass" />
</resources>
