<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- True while ThemeOverlay.SketchwarePro.LiquidGlass is applied to the current theme. -->
    <attr name="liquidGlassEnabled" format="boolean" />

    <declare-styleable name="LiquidGlassView">
        <attr name="glassCornerRadius" format="dimension" />
        <!-- Radius of the backdrop blur. Only used on Android 12+ while Liquid Glass is enabled. -->
        <attr name="glassBlurRadius" format="dimension" />
        <attr name="glassTint" format="color" />
    </declare-styleable>
</resources>
