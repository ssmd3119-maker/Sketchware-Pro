<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ blurs whatever is behind dialogs and sheets, so they can be more translucent.
         If the device has cross-window blur turned off, the system skips the blur and the dim remains. -->
    <item name="glass_alpha_dialog" format="float" type="dimen">0.82</item>

    <style name="ThemeOverlay.SketchwarePro.AlertDialog.Glass" parent="Base.ThemeOverlay.SketchwarePro.AlertDialog.Glass">
        <item name="android:windowBlurBehindEnabled">true</item>
        <item name="android:windowBlurBehindRadius">@dimen/glass_blur_behind_radius</item>
    </style>

    <style name="ThemeOverlay.SketchwarePro.BottomSheetDialog.Glass" parent="Base.ThemeOverlay.SketchwarePro.BottomSheetDialog.Glass">
        <item name="android:windowBlurBehindEnabled">true</item>
        <item name="android:windowBlurBehindRadius">@dimen/glass_blur_behind_radius</item>
    </style>
</resources>
